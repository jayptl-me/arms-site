---
import Base from "../layouts/Base.astro";
import { Button } from "../ui/button/button.tsx";
import "../ui/button/button.css";
import "../styles/directions/signal.css";
import "../styles/signal-site.css";
import { claims } from "../claims.ts";
import { metrics, verdictClass } from "../lib/directions.ts";

/* Sample entries shaped like the live audit: harness -> connector.tool, the policy
   verdict, and the call time. Names and verdicts are the product's own words. */
const trace = [
  { harness: "claude-code", call: "gmail.list_threads", verdict: "ALLOWED", ms: "84" },
  { harness: "cursor", call: "github.create_pull_request", verdict: "DENIED_HARNESS_TOOL", ms: "—" },
  { harness: "windsurf", call: "plane.create_work_item", verdict: "ALLOWED", ms: "121" },
  { harness: "opencode", call: "slack.post_message", verdict: "RATE_LIMITED_RPS", ms: "—" },
  { harness: "claude-desktop", call: "arms.get_status", verdict: "ALLOWED", ms: "3" },
  { harness: "claude-code", call: "github.list_workflow_runs", verdict: "ALLOWED", ms: "97" },
];

const mapRows = [
  { name: "Claude Code", cells: [1, 1, 0, 1, 1] },
  { name: "Cursor", cells: [1, 0, 0, 1, 0] },
  { name: "Windsurf", cells: [1, 1, 1, 1, 0] },
  { name: "OpenCode", cells: [0, 1, 1, 0, 0] },
  { name: "Claude Desktop", cells: [1, 1, 0, 0, 1] },
];
const mapCols = ["Gmail", "GitHub", "Slack", "Plane", "Postgres"];

const connectorScopes: Record<string, string> = {
  Gmail: "mail",
  GitHub: "code",
  GitLab: "code",
  Plane: "work",
  Jira: "work",
  Linear: "work",
  Notion: "docs",
  Slack: "chat",
  Postgres: "data",
  Redis: "data",
  S3: "objects",
  Docker: "runtime",
};

const claimGroups = [
  ["What it does", claims.does],
  ["Control plane", claims.plane],
  ["Before a call goes out", claims.decisions],
  ["Still on your machine", claims.local],
] as const;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ARMS",
  url: "https://arms.whyknot.live",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  author: { "@type": "Organization", name: "WhyKnot", url: "https://whyknot.live" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title="ARMS, a local-first AI agent gateway" description="Open-source tools for agents, on your machine.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <div class="signal-page" data-direction="signal-objects">
    <section class="signal-hero">
      <div class="signal-copy">
        <p class="signal-kicker">Local-first agent gateway</p>
        <h1>{claims.headline}</h1>
        <p class="lead">{claims.lead}</p>
        <p class="signal-opening">{claims.opening}</p>
        <div class="signal-actions">
          <Button as="a" href={claims.action.href} variant="primary" size="large">{claims.action.label}</Button>
          <a class="signal-button secondary" href="#policy-proof">See policy proof</a>
        </div>
        <p class="harnesslead">{claims.harnessLead}</p>
        <div class="signal-harnesses" aria-label="Supported harnesses">
          {claims.harnesses.map((harness) => (
            <span>{harness}</span>
          ))}
        </div>
      </div>
      <div class="signal-proof" aria-label="Real ARMS console preview">
        <div class="proof-bar"><span>ARMS console</span><span>deployed build proof</span></div>
        <img class="shot shot-dark" src="/console-proof/dark-overview-tabs.webp" alt="Real ARMS console preview in dark mode" width="1600" height="1000" loading="eager" />
        <img class="shot shot-light" src="/console-proof/light-overview-tabs.webp" alt="Real ARMS console preview in light mode" width="1600" height="1000" loading="eager" />
      </div>
    </section>

    <section class="signal-metrics" aria-label="Product facts">
      {metrics.map((m, index) => (
        <article>
          <span class="metric-num">{m.value}</span>
          <span class="metric-label">{m.label}</span>
          <span class="metric-note">0{index + 1} · {m.note}</span>
        </article>
      ))}
    </section>

    <section class="signal-board" id="policy-proof">
      <div class="section-head">
        <div>
          <p class="eyebrow">Policy filter</p>
          <h2>Every call keeps its verdict.</h2>
        </div>
        <div class="filter-controls" role="group" aria-label="policy filter">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          <button type="button" aria-pressed="false" data-filter="ALLOWED">Allowed</button>
          <button type="button" aria-pressed="false" data-filter="DENIED_HARNESS_TOOL">Denied</button>
          <button type="button" aria-pressed="false" data-filter="RATE_LIMITED_RPS">Limited</button>
        </div>
      </div>
      <div class="signal-table" tabindex="0" aria-label="Sample policy audit rows">
        <div class="table-head"><span>Harness</span><span>Call</span><span>Verdict</span><span>ms</span></div>
        {trace.map((row) => (
          <div class="table-row" data-verdict={row.verdict}>
            <span>{row.harness}</span>
            <strong>{row.call}</strong>
            <span class={`verdict ${verdictClass(row.verdict)}`}>{row.verdict}</span>
            <span class="ms">{row.ms}</span>
          </div>
        ))}
      </div>
      <p class="signal-more"><a href="/log">Open the full policy log</a></p>
    </section>

    <section class="signal-map-section" aria-labelledby="connection-map-title">
      <div class="section-head compact">
        <div>
          <p class="eyebrow">Connection map.</p>
          <h2 id="connection-map-title">Which harness may reach which tool.</h2>
        </div>
      </div>
      <figure class="signal-map" tabindex="0" aria-label="Sample of which harness may reach which connector">
        <figcaption>Connection map · sample</figcaption>
        <table>
          <thead>
            <tr><td></td>{mapCols.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {mapRows.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                {r.cells.map((c) => (
                  <td><span class={c ? "cell on" : "cell off"}>{c ? "allow" : "off"}</span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </figure>
    </section>

    <section class="signal-connectors">
      <div class="section-head compact">
        <div>
          <p class="eyebrow">Connector inventory</p>
          <h2>Named tools, no decoration.</h2>
        </div>
      </div>
      <div class="connector-grid">
        {claims.connectors.map((connector, index) => (
          <details class="signal-connector-card" open={index === 0}>
            <summary><span>{connector.name}</span><span>{connectorScopes[connector.name] ?? "tool"}</span></summary>
            <p>{connector.body}</p>
          </details>
        ))}
      </div>
    </section>

    {claimGroups.map(([title, items]) => (
      <section class="signal-claims" aria-labelledby={`claims-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
        <div class="section-head compact">
          <div>
            <p class="eyebrow">Product object</p>
            <h2 id={`claims-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{title}</h2>
          </div>
        </div>
        <div class="claim-grid">
          {items.map((point, index) => (
            <article>
              <span class="claim-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="signal-close">
      <p class="eyebrow">Open tools, local first</p>
      <h2>The gateway stays inspectable.</h2>
      <p>
        ARMS is open source, runs on your machine, keeps its policy decisions visible, and stores credentials in an encrypted vault whose key stays with you.
      </p>
      <div class="signal-actions">
        <a class="signal-button" href={claims.action.href}>Get ARMS on GitHub</a>
        <a class="signal-button secondary" href={claims.issue.href}>{claims.issue.label}</a>
      </div>
    </section>
  </div>

  <script is:inline>
    const buttons = document.querySelectorAll("[data-filter]");
    const rows = document.querySelectorAll(".table-row[data-verdict]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-filter");
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        rows.forEach((row) => {
          row.hidden = filter !== "all" && row.getAttribute("data-verdict") !== filter;
        });
      });
    });
  </script>
</Base>
