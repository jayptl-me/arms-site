---
import Base from "../layouts/Base.astro";
import { Button } from "../ui/button/button.tsx";
import { Separator } from "../ui/separator/separator.tsx";
import "../ui/button/button.css";
import "../ui/separator/separator.css";
import "../styles/home.css";
import { claims } from "../claims.ts";

/* Sample entries shaped like the live audit: harness -> connector.tool, the policy
   verdict, and the call time. Names and verdicts are the product's own words. */
const trace = [
  { harness: "claude-code", call: "gmail.list_threads", verdict: "ALLOWED", ms: "84" },
  { harness: "cursor", call: "github.create_pull_request", verdict: "DENIED_TOOL", ms: "—" },
  { harness: "windsurf", call: "plane.create_work_item", verdict: "ALLOWED", ms: "121" },
  { harness: "opencode", call: "slack.post_message", verdict: "RATE_LIMITED_TOOL", ms: "—" },
  { harness: "claude-desktop", call: "arms.get_status", verdict: "ALLOWED", ms: "3" },
  { harness: "claude-code", call: "github.list_workflow_runs", verdict: "ALLOWED", ms: "97" },
];

const mapRows = [
  { name: "Claude Code", cells: [1, 1, 0, 1, 1] },
  { name: "Cursor", cells: [1, 0, 0, 1, 0] },
  { name: "Windsurf", cells: [1, 1, 1, 1, 0] },
  { name: "OpenCode", cells: [0, 1, 1, 0, 0] },
  { name: "Claude Desktop", cells: [1, 1, 0, 0, 1] },
];
const mapCols = ["Gmail", "GitHub", "Slack", "Plane", "Postgres"];

const jsonld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ARMS",
  url: "https://arms.whyknot.live",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  author: { "@type": "Organization", name: "WhyKnot", url: "https://whyknot.live" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title="ARMS, a local-first AI agent gateway" description="Open-source tools for agents, on your machine.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <div class="container">
    <section class="hero">
      <div class="intro">
        <h1>{claims.headline}</h1>
        <p class="lead">{claims.lead}</p>
        <p class="sub">{claims.opening}</p>
        <div class="btn-row">
          <Button as="a" href={claims.action.href} variant="primary" size="large">{claims.action.label}</Button>
          <a class="btn ghost" href="#map">See the map</a>
        </div>
        <p class="harnesslead">{claims.harnessLead}</p>
        <div class="chips">
          {claims.harnesses.map((harness) => (
            <span class="chip">{harness}</span>
          ))}
        </div>
      </div>
      <figure class="trace" id="trace" tabindex="0" aria-label="A sample policy request log from the gateway">
        <figcaption>Policy log · sample</figcaption>
        <ul>
          {trace.map((t) => (
            <li>
              <span class="t-harness">{t.harness}</span>
              <span class="t-call">{t.call}</span>
              <span class={`t-verdict ${t.verdict === "ALLOWED" ? "ok" : "no"}`}>{t.verdict}</span>
              <span class="t-ms">{t.ms}</span>
            </li>
          ))}
        </ul>
      </figure>
    </section>
    <figure class="map" id="map" tabindex="0" aria-label="Sample of which harness may reach which connector">
      <figcaption>Connection map · sample</figcaption>
      <table>
        <thead>
          <tr><td></td>{mapCols.map((c) => <th scope="col">{c}</th>)}</tr>
        </thead>
        <tbody>
          {mapRows.map((r) => (
            <tr>
              <th scope="row">{r.name}</th>
              {r.cells.map((c) => (
                <td><span class={c ? "cell on" : "cell off"}>{c ? "allow" : "off"}</span></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </figure>
    <section class="points">
      <h2>What it does</h2>
      <div class="row">
        {
          claims.does.map((point) => (
            <div class="point">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          ))
        }
      </div>
    </section>
    <section class="points">
      <h2>Control plane</h2>
      <div class="row">
        {
          claims.plane.map((point) => (
            <div class="point">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          ))
        }
      </div>
    </section>
    <section class="points">
      <h2>Before a call goes out</h2>
      <div class="row">
        {
          claims.decisions.map((point) => (
            <div class="point">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          ))
        }
      </div>
    </section>
    <section class="points">
      <h2>Native connectors</h2>
      <div class="row">
        {
          claims.connectors.map((item) => (
            <div class="point">
              <h3>{item.name}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </section>
    <section class="points">
      <h2>Still on your machine</h2>
      <div class="row">
        {
          claims.local.map((point) => (
            <div class="point">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          ))
        }
      </div>
    </section>
    <Separator ornamental={false} />
  </div>
</Base>
