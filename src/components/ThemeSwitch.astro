---
// Theme choice: follow the system (default), or a stored light or dark choice.
---

<div class="theme-switch">
  <label for="theme-choice">Theme</label>
  <select id="theme-choice" name="theme">
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</div>

<script>
  const root = document.documentElement;
  const select = document.getElementById("theme-choice") as HTMLSelectElement | null;
  if (select) {
    const stored = root.dataset.theme;
    select.value = stored === "light" || stored === "dark" ? stored : "system";
    select.addEventListener("change", () => {
      const value = select.value;
      try {
        if (value === "light" || value === "dark") {
          root.dataset.theme = value;
          localStorage.setItem("theme", value);
        } else {
          delete root.dataset.theme;
          localStorage.removeItem("theme");
        }
      } catch {
        // Storage blocked: the choice still applies to this page view.
        if (value === "light" || value === "dark") root.dataset.theme = value;
        else delete root.dataset.theme;
      }
    });
  }
</script>
